# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/optiwise

# Port the API server runs on
PORT=5000

# Secret used to sign admin login JWTs — change this to a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Comma separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Used once by "npm run seed:admin" to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
